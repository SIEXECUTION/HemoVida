@startuml
' Catálogo PostgreSQL public de HemoVida verificado el 22-11-2026
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FAF1E4
skinparam classBorderColor #6E6359
skinparam classFontColor #202020
skinparam ArrowColor #615850
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F7F8
skinparam packageBorderColor #A6A6A6
skinparam linetype polyline
skinparam nodesep 23
skinparam ranksep 30
left to right direction
title HemoVida · Modelo de dominio
package "Personas, acceso y auditoría" {
class "Persona" as T_persona
class "Usuario" as T_usuario
class "Rol" as T_rol
class "UsuarioRol" as T_usuariorol
class "PersonalSalud" as T_personalsalud
class "BitacoraAuditoria" as T_bitacoraauditoria
}
package "Donantes y receptores" {
class "PosibleDonador" as T_posibledonador
class "Donante" as T_donante
class "Receptor" as T_receptor
class "CategoriaEtariaDonante" as T_categoriaetariadonante
}
package "Agenda, prefiltro y programación autóloga" {
class "AgendaTurno" as T_agendaturno
class "CierreAgenda" as T_cierreagenda
class "CitaDonacion" as T_citadonacion
class "RequisitoDonacion" as T_requisitodonacion
