@startuml
!pragma layout smetana
' Catálogo PostgreSQL public de HemoVida verificado el 22-11-2026
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FAF1E4
skinparam classBorderColor #6E6359
skinparam classFontColor #202020
skinparam ArrowColor #615850
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F7F8
skinparam packageBorderColor #A6A6A6
skinparam linetype polyline
skinparam nodesep 23
skinparam ranksep 30
left to right direction
title HemoVida · Clases de persistencia
package "Personas, acceso y auditoría" {
class "Persona" as T_persona {
  idpersona : integer [PK]
  ci : varchar(20)
  nombres : varchar(80)
  apellidos : varchar(80)
  sexo : char(1)
  fechanacimiento : date
  direccion : varchar(150) {opcional}
  celular : varchar(20) {opcional}
  ocupacion : varchar(80) {opcional}
  nacionalidad : varchar(50) {opcional}
  --
  {field} UNIQUE (ci)
}
class "Usuario" as T_usuario {
  idusuario : integer [PK]
  idpersona : integer [FK]
  username : varchar(50)
  email : varchar(100)
  passwordhash : varchar(255)
  estado : varchar(20)
  fechacreacion : timestamp
  intentosfallidos : integer
  fechabloqueohasta : timestamp {opcional}
  totalbloqueosrecibidos : integer
  fechaintentosdia : date {opcional}
  --
  {field} UNIQUE (email)
  {field} UNIQUE (idpersona)
  {field} UNIQUE (username)
}
class "Rol" as T_rol {
  idrol : integer [PK]
  nombrerol : varchar(60)
  codigorol : varchar(30)
  descripcion : text {opcional}
  --
  {field} UNIQUE (codigorol)
  {field} UNIQUE (nombrerol)
}
class "UsuarioRol" as T_usuariorol {
  idusuario : integer [PK, FK]
  idrol : integer [PK, FK]
  fechaasignacion : timestamp
}
class "PersonalSalud" as T_personalsalud {
  idpersona : integer [PK, FK]
  cargo : varchar(80)
  registroprofesional : varchar(40)
  --
  {field} UNIQUE (registroprofesional)
}
class "BitacoraAuditoria" as T_bitacoraauditoria {
  idauditoria : integer [PK]
  idusuario : integer [FK] {opcional}
  rolactivo : varchar(60) {opcional}
  accionrealizada : varchar(255)
  tablaafectada : varchar(60)
  idregistroafectado : integer {opcional}
  fechahora : timestamp
  iporigen : varchar(45) {opcional}
}
}
package "Donantes y receptores" {
class "PosibleDonador" as T_posibledonador {
