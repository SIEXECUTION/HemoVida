# Configuración de Entorno HemoVida Backend
DEBUG=False
SECRET_KEY=django-insecure-hemovida-bloodbank-secret-key-2025-secure-token-xyz789
ALLOWED_HOSTS=*

# Opción 1: Conexión a Base de Datos en Supabase Cloud (Recomendada en Koyeb)
# Obtén la URI en: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Ejemplo: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Opción 2: Parámetros individuales (PostgreSQL Local)
USE_SQLITE=False
DB_NAME=Hemovida
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Orígenes Permitidos para CORS (Frontend Vercel / Local)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
