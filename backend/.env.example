# Producción: configura los valores desde Render. Desarrollo: preparar_local.ps1 crea backend/.env.
DEBUG=False
SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO
ALLOWED_HOSTS=localhost,127.0.0.1

# Copia la URI Transaction pooler de Supabase (puerto 6543).
# Codifica caracteres especiales de la contraseña como parte de la URI.
# Ejemplo de formato, NO es una conexión válida:
# postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_TRANSACTION_POOLER=True
USE_SQLITE=False

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# En desarrollo los correos se muestran en terminal; no se envían a pacientes.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HemoVida <local@example.test>

# En Render estas variables envían correos por HTTPS mediante Brevo, sin SMTP.
# Usa una API key de Brevo y un remitente verificado; no una clave SMTP.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# PYTHON_VERSION se configura en Render, no cambia el Python del entorno local.
